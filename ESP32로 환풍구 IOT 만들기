def web_server():
    global auto_mode
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('', 80))
    s.listen(5)
    
    print("웹 서버 시작!")
    print("접속: http://" + wifi.ifconfig()[0])
    print("-" * 40)
    
    while True:
        try:
            conn, addr = s.accept()
            request = conn.recv(1024).decode()
            
            if 'mode=auto' in request:
                auto_mode = True
                print('자동 모드')
            elif 'mode=manual' in request:
                auto_mode = False
                print('수동 모드')
            
            if not auto_mode:
                if 'fan=on' in request:
                    relay.value(1)
                    print('팬 ON')
                elif 'fan=off' in request:
                    relay.value(0)
                    print('팬 OFF')
            
            if auto_mode:
                sensor_value, _, _ = read_sensor()
                if sensor_value >= 800:
                    relay.value(1)
                else:
                    relay.value(0)
            
            sensor_value, air_quality, color = read_sensor()
            fan_state = 'ON' if relay.value() else 'OFF'
            fan_class = 'fan-on' if relay.value() else 'fan-off'
            fan_icon = '🌀' if relay.value() else '⏹️'
            mode_state = '자동' if auto_mode else '수동'
            
            response = HTML_TEMPLATE.format(
                color=color,
                air_quality=air_quality,
                sensor_value=sensor_value,
                fan_state=fan_state,
                fan_class=fan_class,
                fan_icon=fan_icon,
                mode_state=mode_state
            )
            
            conn.send('HTTP/1.1 200 OK\r\n')
            conn.send('Content-Type: text/html; charset=utf-8\r\n')
            conn.send('Connection: close\r\n\r\n')
            conn.sendall(response)
            conn.close()
            
        except Exception as e:
            print('오류:', e)

