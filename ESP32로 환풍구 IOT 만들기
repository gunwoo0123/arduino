# MQ-135 센서 설정
mq135 = ADC(Pin(34))
mq135.atten(ADC.ATTN_11DB)
mq135.width(ADC.WIDTH_12BIT)

# 릴레이 설정
relay = Pin(5, Pin.OUT)
relay.value(0)

# 네오픽셀 설정 (GPIO14, 12개 LED)
np = NeoPixel(Pin(14), 12)

# 네오픽셀 색상 설정 함수
def set_neopixel_color(sensor_value):
    if sensor_value < 400:
        color = (0, 255, 0)  # 매우 좋음 - 초록
    elif sensor_value < 600:
        color = (100, 255, 0)  # 좋음 - 연두
    elif sensor_value < 800:
        color = (255, 200, 0)  # 보통 - 노랑
    elif sensor_value < 1000:
        color = (255, 100, 0)  # 나쁨 - 주황
    else:
        color = (255, 0, 0)  # 매우 나쁨 - 빨강
    
    for i in range(12):
        np[i] = color
    np.write()

# 자동/수동 모드
auto_mode = True

# 센서 읽기
def read_sensor():
    sensor_value = mq135.read()
    
    if sensor_value < 400:
        air_quality = "매우 좋음"
        color = "#28a745"
    elif sensor_value < 600:
        air_quality = "좋음"
        color = "#5cb85c"
    elif sensor_value < 800:
        air_quality = "보통"
        color = "#ffc107"
    elif sensor_value < 1000:
        air_quality = "나쁨"
        color = "#fd7e14"
    else:
        air_quality = "매우 나쁨"
        color = "#dc3545"
    
    set_neopixel_color(sensor_value)
    return sensor_value, air_quality, color

